{
	"info": {
		"_postman_id": "8a72b6c1-4b13-48e2-b94f-7c1529ea4512",
		"name": "MMC - Provider Service Subscriptions & Configuration API",
		"description": "Comprehensive Postman collection for Provider Service Subscriptions, Unsubscriptions, Service Configuration (Estimated Time, Mobile/Workshop Delivery Methods, Flat Pricing, Tyre Details, Car Hire & Chauffeur Fleet addition), and Customer-side verification matching the Web Panel at http://localhost/mmc/provider/service/available.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Subscriptions Management",
			"item": [
				{
					"name": "1. Available Services (With is_subscribed & Badges)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{provider_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/provider/service/available-services?category_id=all&limit=50&offset=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"provider",
								"service",
								"available-services"
							],
							"query": [
								{
									"key": "category_id",
									"value": "all",
									"description": "'all' or category UUID"
								},
								{
									"key": "limit",
									"value": "50"
								},
								{
									"key": "offset",
									"value": "1"
								}
							]
						},
						"description": "Lists all available services in the provider's zone along with categories, is_subscribed boolean, estimated_time, service_types badges, and custom prices."
					},
					"response": []
				},
				{
					"name": "2. My Subscriptions (Subscribed Services List)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{provider_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/provider/service?status=subscribed&limit=50&offset=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"provider",
								"service"
							],
							"query": [
								{
									"key": "status",
									"value": "subscribed",
									"description": "'subscribed', 'unsubscribed', or 'all'"
								},
								{
									"key": "limit",
									"value": "50"
								},
								{
									"key": "offset",
									"value": "1"
								}
							]
						},
						"description": "Returns ONLY the services that this provider has subscribed to."
					},
					"response": []
				},
				{
					"name": "3. Subscribe Service (Dedicated API)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{provider_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"service_id\": \"{{service_id}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/provider/service/subscribe",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"provider",
								"service",
								"subscribe"
							]
						},
						"description": "Explicitly subscribes the provider to a single service."
					},
					"response": []
				},
				{
					"name": "4. Unsubscribe Service (Dedicated API)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{provider_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"service_id\": \"{{service_id}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/provider/service/unsubscribe",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"provider",
								"service",
								"unsubscribe"
							]
						},
						"description": "Explicitly unsubscribes the provider from a single service."
					},
					"response": []
				},
				{
					"name": "5. Toggle Subscription (Subscribe / Unsubscribe Switch)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{provider_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"service_id\": [\n    \"{{service_id}}\"\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/provider/service/update-subscription",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"provider",
								"service",
								"update-subscription"
							]
						},
						"description": "Toggles subscription status for array of service IDs. If unsubscribed -> subscribes. If subscribed -> unsubscribes."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Service Configuration (Modal on Web)",
			"item": [
				{
