		{
			"name": "3. Customer-Side Verification",
			"item": [
				{
					"name": "1. Search Providers by Service (Check Badges & Configured Rates)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "zoneid",
								"value": "{{zone_id}}",
								"description": "Target zone ID"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"service_ids\": [\n    \"{{service_id}}\"\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/customer/provider/search-by-service",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customer",
								"provider",
								"search-by-service"
							]
						},
						"description": "Verifies that customer receives the provider's service_types (mobile/workshop), estimated_time, service_price, and sample completed_service_images."
					},
					"response": []
				},
