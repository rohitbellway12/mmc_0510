                                "value": "{{ZONE_ID}}"
                            }
                        ],
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/customer/service/category/{{CATEGORY_ID}}?limit=10&offset=1",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
