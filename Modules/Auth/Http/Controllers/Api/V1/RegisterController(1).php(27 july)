    public function providerRegistrationStep1(Request $request): JsonResponse
{
    $validator = Validator::make($request->all(), [
        'first_name' => 'required',
        'last_name' => 'required',
        'email' => 'required|email|unique:users,email',
        'phone' => 'required|regex:/^([0-9\s\-\+\(\)]*)$/|min:10|unique:users,phone',
        'password' => 'required|min:8',
        'confirm_password' => 'required|same:password',
        'zone_id' => 'required|uuid',
        'latitude' => 'required',
        'longitude' => 'required',
    ]);

    if ($validator->fails()) {
        return response()->json(response_formatter(DEFAULT_400, null, error_processor($validator)), 400);
    }

    $user = $this->user;
    $user->first_name = $request->first_name;
    $user->last_name = $request->last_name;
    $user->email = $request->email;
    $user->phone = $request->phone;
    $user->password = bcrypt($request->password);
    $user->user_type = 'provider-admin';
    $user->is_active = 0;
    $user->is_phone_verified = 0;
    $user->is_email_verified = 0;
    $user->save();

    $provider = $this->provider;
    $provider->user_id = $user->id;
    $provider->zone_id = $request->zone_id;
    $provider->coordinates = ['latitude' => $request->latitude, 'longitude' => $request->longitude];
    $provider->is_active = 0;
    $provider->is_approved = 0;
    $provider->save();

    $token = rand(1000, 9999);

    // Store OTP for phone
    DB::table('user_verifications')->insert([
        'identity' => $request['phone'],
        'identity_type' => 'phone',
        'otp' => $token,
        'expires_at' => now()->addMinutes(5),
        'created_at' => now(),
        'updated_at' => now(),
    ]);

    // Store OTP for email
    DB::table('user_verifications')->insert([
        'identity' => $request['email'],
        'identity_type' => 'email',
        'otp' => $token,
        'expires_at' => now()->addMinutes(5),
        'created_at' => now(),
        'updated_at' => now(),
    ]);

    // ===== SEND OTP VIA SMS =====
    $publishedStatus = 0;
    $paymentPublishedStatus = config('get_payment_publish_status');
    if (isset($paymentPublishedStatus[0]['is_published'])) {
        $publishedStatus = $paymentPublishedStatus[0]['is_published'];
    }

    if ($publishedStatus == 1) {
        $response = \Modules\PaymentModule\Traits\SmsGateway::send($request['phone'], $token);
    } else {
        \Modules\SMSModule\Lib\SMS_gateway::send($request['phone'], $token);
    }

    // ===== SEND OTP VIA EMAIL =====
    try {
        $emailStatus = business_config('email_config_status', 'email_config')?->live_values ?? 0;
        
        if (!$emailStatus) {
            \Log::warning('Email config is disabled. OTP for ' . $request['email'] . ': ' . $token);
        } else {
            if (class_exists(\Modules\UserManagement\Emails\OTPMail::class)) {
                Mail::to($request['email'])->send(new \Modules\UserManagement\Emails\OTPMail($token));
            } else {
                Mail::send([], [], function ($message) use ($request, $token) {
                    $message->to($request['email'])
                            ->subject('Your OTP for Registration')
                            ->setBody("
                                <html>
                                    <head>
                                        <style>
                                            body { font-family: Arial, sans-serif; }
                                            .otp { font-size: 32px; font-weight: bold; color: #4a90d9; padding: 20px; background: #f5f5f5; text-align: center; }
                                        </style>
                                    </head>
                                    <body>
                                        <h2>Registration OTP Verification</h2>
                                        <p>Hello {$request->first_name},</p>
                                        <p>Your OTP is:</p>
                                        <div class='otp'>{$token}</div>
                                        <p>This OTP is valid for 5 minutes.</p>
                                        <p>Please do not share this OTP with anyone.</p>
                                    </body>
                                </html>
                            ", 'text/html');
                });
            }
            \Log::info('OTP sent via Email to: ' . $request['email']);
        }
    } catch (Exception $exception) {
        \Log::error('OTP email failed for ' . $request['email'] . ': ' . $exception->getMessage());
    }

    return response()->json(response_formatter(DEFAULT_SENT_OTP_200, ['otp' => $token]), 200);
}

    public function providerVerification(Request $request): JsonResponse
    {
        $validator = Validator::make($request->all(), [
            'identity' => 'required',
            'otp' => 'required'
        ]);

        if ($validator->fails()) {
            return response()->json(response_formatter(DEFAULT_400, null, error_processor($validator)), 400);
        }

        $data = DB::table('user_verifications')
            ->where('identity', $request['identity'])
            ->where(['otp' => $request['otp']])
            ->where('expires_at', '>', now())
            ->first();

        if (isset($data)) {
            $user = $this->user->where('user_type', 'provider-admin')
                ->where('phone', $request['identity'])
                ->first();

            if ($user) {
                $user->is_phone_verified = 1;
                $user->is_active = 1;
                $user->save();

                /*
                $provider = $this->provider->where('user_id', $user->id)->first();
                if (!$provider) {
                    $provider = new $this->provider();
                    $provider->user_id = $user->id;
                    $provider->zone_id = $request->zone_id ?? config('zone_id');
                    $provider->coordinates = ['latitude' => 0, 'longitude' => 0];
                    $provider->is_active = 0;
                    $provider->is_approved = 0;
                    $provider->save();
                }
                */

                DB::table('user_verifications')
                    ->where('identity', $request['identity'])
                    ->where(['otp' => $request['otp']])
                    ->delete();

                $token = $user->createToken(PROVIDER_PANEL_ACCESS)->accessToken;

                return response()->json(response_formatter(DEFAULT_VERIFIED_200, ['token' => $token, 'is_active' => $user->is_active]), 200);
            }
        }

        return response()->json(response_formatter(DEFAULT_404, null, [['message' => 'Invalid or expired OTP.']]), 404);
    }



